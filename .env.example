# Google AI Studio API key (AQ. prefix) or Groq API key (gsk_ prefix)
# GROQ_API_KEY=gsk_your_groq_api_key_here

# Cloud Production Backend URL:
# IMPORTANT: Before running `flutter build apk` for production, the developer must replace
# this placeholder with their actual Render / Railway / GCP deployment URL.
# (For local offline testing, use: http://127.0.0.1:8000/api/v1)
AVARA_API_BASE_URL=https://YOUR-CLOUD-URL-HERE.com/api/v1
